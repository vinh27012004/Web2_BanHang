# Mẫu cấu hình cục bộ.
# Sao chép file này thành "application-local.properties" rồi điền thông tin thật.
# File application-local.properties đã được .gitignore bỏ qua nên sẽ KHÔNG bị commit.
#
# Cách kích hoạt profile local khi chạy:
#   mvnw spring-boot:run -Dspring-boot.run.profiles=local
# hoặc đặt biến môi trường: SPRING_PROFILES_ACTIVE=local

spring.datasource.url=jdbc:mysql://localhost:3306/banhang
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD_HERE

# (Tùy chọn) Tài khoản nhận tiền cho thanh toán QR (VietQR).
# Bỏ trống account-no nếu chưa muốn bật QR.
vietqr.bank-bin=970415
vietqr.account-no=YOUR_ACCOUNT_NUMBER
vietqr.account-name=TEN CHU TAI KHOAN
